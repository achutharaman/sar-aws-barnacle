{
  "permissions": {
    "allow": [
      "Bash(python3 -m venv .venv)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(echo \"PYTEST_EXIT:$?\")",
      "Bash(.venv/bin/python -m ruff check .)",
      "Bash(echo \"RUFF_CHECK_EXIT:$?\")",
      "Bash(.venv/bin/python -m ruff format --check .)"
    ]
  }
}
